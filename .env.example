# Copy this file to .env and fill in your own values.

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET=replace-with-a-long-random-secret-but-i-wont-replace-with-a-long-secret-cus-do-what-i-want-douche-bag

# Optional: leave empty to disable rate limiting locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32-byte base64 key used to encrypt admin TOTP secrets.
MFA_ENCRYPTION_KEY=
# Used by prisma/seed.ts to create the first super admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
